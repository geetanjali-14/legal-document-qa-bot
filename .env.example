# Application Settings
APP_NAME="Legal Document QA Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Document & Ingestion Constraints
UPLOAD_DIR="data/uploads"
VECTOR_STORE_DIR="data/vector_store"
DATABASE_PATH="data/legal_qa.db"
# Production Database URL (e.g. postgresql://user:password@localhost:5432/legal_qa; leave empty for SQLite)
DATABASE_URL=
MAX_FILE_SIZE_MB=25
MAX_CHUNKS_PER_DOC=5000

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50

# Retrieval Parameters
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# LLM Configuration
# Providers: mock, groq, openai, gemini, grok, mistral, anthropic, ollama, custom_http
LLM_PROVIDER=groq
LLM_API_KEY=
# Common models: llama-3.3-70b-versatile (Groq), gemini-3.8-flash (Gemini), gpt-4o-mini (OpenAI)
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Embedding Configuration
# Providers: mock, tfidf, fastembed, openai, ollama
EMBEDDING_PROVIDER=tfidf
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# OCR Configuration
# Providers: local (RapidOCR / Tesseract), mistral, gemini
OCR_PROVIDER=local
OCR_API_KEY=

