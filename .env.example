# Application Settings
APP_NAME="Legal Document QA Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Demo Mode & Public Safeguards
# Set DEMO_MODE=true on public demos to disable uploads, deletions, and isolate sessions
DEMO_MODE=false
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"
RATE_LIMIT_CHAT_PER_MINUTE=15
RATE_LIMIT_CONV_PER_MINUTE=30

# Document & Ingestion Constraints
UPLOAD_DIR="data/uploads"
VECTOR_STORE_DIR="data/vector_store"
DATABASE_PATH="data/legal_qa.db"
# Production Database URL (e.g. postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require; leave empty for SQLite)
DATABASE_URL=

# Storage Backend: "local" (default) or "supabase" (Supabase Storage)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_NAME="legal-qa-documents"
MAX_FILE_SIZE_MB=25
MAX_CHUNKS_PER_DOC=5000

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50

# Retrieval Parameters
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# LLM Configuration
# Providers: groq (default), gemini, openai, mock
LLM_PROVIDER=groq
LLM_API_KEY=
# Common models: llama-3.3-70b-versatile (Groq), gemini-2.5-flash (Gemini), gpt-4o-mini (OpenAI)
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Embedding Configuration
# Providers: gemini, fastembed, tfidf, openai, mock
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
# Slack Configuration
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_APP_TOKEN="xapp-your-app-token"
LEGAL_QA_API_BASE_URL="http://localhost:8000/api/v1"
